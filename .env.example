APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

PULSE_ENABLED=false
PULSE_PATH=pulse
# PULSE_DOMAIN=
# PULSE_DB_CONNECTION=
# Unique per application server in a multi-server deployment — the
# Servers card keys entries by this name. Defaults to the OS hostname
# when unset, which is rarely unique/stable across containers/VMs.
# PULSE_SERVER_NAME=
# PULSE_SERVER_DIRECTORIES=/
# Left unset by default: Pulse's card cache then uses this app's normal
# CACHE_STORE. Before relying on that in a new environment, confirm the
# dashboard stays stable under real Livewire polling (repeated updates on
# each card) — one specific local dev machine (PHP 8.5.7, built-in
# `php artisan serve`) intermittently threw "incomplete object" errors
# reading its own cached Collection values back from the database cache
# store; a controlled experiment ruled out OPcache/interned-strings
# settings as the cause (see docs/pulse-monitoring.md) and the underlying
# PHP/cli-server-SAPI issue is still unresolved. If you hit the same
# symptom, PULSE_CACHE_DRIVER=array is a proven workaround — Pulse's card
# values then aren't cached across separate requests (every poll
# recomputes fresh, meaning more frequent Pulse storage queries), so only
# use it if you've actually observed the failure, not preemptively.
# PULSE_CACHE_DRIVER=
PULSE_STORAGE_KEEP="7 days"
PULSE_INGEST_KEEP="7 days"
PULSE_SLOW_REQUESTS_THRESHOLD=1000
PULSE_SLOW_QUERIES_THRESHOLD=1000
PULSE_SLOW_JOBS_THRESHOLD=1000
PULSE_SLOW_OUTGOING_REQUESTS_THRESHOLD=1000

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Production: resend. Local development may use log; tests may use array.
MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@sirieducation.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
RESEND_DOMAIN=
RESEND_PATH=resend
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_TOLERANCE=300

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Class recording storage ───────────────────────────────────────────
# Which backend holds recording FILES. "filesystem" uses the disk named
# below; "google_drive" uses the platform Workspace account configured
# in the admin Meeting settings.
#
# Amazon S3 later is a configuration change only — no new code:
#   RECORDING_STORAGE_DRIVER=filesystem
#   RECORDING_STORAGE_DISK=s3
#
# Google Drive CREDENTIALS are deliberately NOT env vars: the
# service-account JSON is stored encrypted in the database via the admin
# Meeting settings screen, alongside the Google Meet configuration that
# uses the same account. Never commit credential JSON to this file.
RECORDING_STORAGE_DRIVER=filesystem
# Must be a PRIVATE disk. Never "public".
RECORDING_STORAGE_DISK=local
RECORDING_STAGING_STALE_HOURS=24
RECORDING_MAX_SOURCE_BYTES=5368709120
RECORDING_DRIVE_CHUNK_BYTES=8388608
RECORDING_DRIVE_TIMEOUT=600
# Student playback delivery (docs/recordings.md §8): bounded window per
# ranged response, read chunk, watermark movement, denial-audit window.
RECORDING_PLAYBACK_MAX_RANGE_BYTES=8388608
RECORDING_PLAYBACK_CHUNK_BYTES=524288
RECORDING_WATERMARK_MOVE_SECONDS=12
RECORDING_DENIAL_AUDIT_WINDOW_SECONDS=900
# Meet space access for auto-recorded lessons: OPEN (start without host), TRUSTED, RESTRICTED
RECORDING_MEET_SPACE_ACCESS=OPEN
# Dedicated long-running ingestion queue. retry_after MUST stay above
# CaptureLessonRecordingJob's 3600s timeout — see docs/recordings.md.
RECORDING_QUEUE_DRIVER=database
RECORDING_QUEUE_RETRY_AFTER=3900

VITE_APP_NAME="${APP_NAME}"
